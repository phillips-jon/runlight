{
  "name": "@runlight/sdk",
  "version": "0.0.0",
  "description": "Privacy friendly web analytics that lives inside your app. Mount a route, add a script tag, read your stats at /runlight.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phillips-jon/runlight.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://runlight.sh",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sqlite": {
      "import": {
        "types": "./dist/sqlite.d.ts",
        "default": "./dist/sqlite.js"
      },
      "require": {
        "types": "./dist/sqlite.d.cts",
        "default": "./dist/sqlite.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres.d.ts",
        "default": "./dist/postgres.js"
      },
      "require": {
        "types": "./dist/postgres.d.cts",
        "default": "./dist/postgres.cjs"
      }
    },
    "./mysql": {
      "import": {
        "types": "./dist/mysql.d.ts",
        "default": "./dist/mysql.js"
      },
      "require": {
        "types": "./dist/mysql.d.cts",
        "default": "./dist/mysql.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./libsql": {
      "import": {
        "types": "./dist/libsql.d.ts",
        "default": "./dist/libsql.js"
      },
      "require": {
        "types": "./dist/libsql.d.cts",
        "default": "./dist/libsql.cjs"
      }
    },
    "./d1": {
      "import": {
        "types": "./dist/d1.d.ts",
        "default": "./dist/d1.js"
      },
      "require": {
        "types": "./dist/d1.d.cts",
        "default": "./dist/d1.cjs"
      }
    },
    "./bun": {
      "import": {
        "types": "./dist/bun.d.ts",
        "default": "./dist/bun.js"
      },
      "require": {
        "types": "./dist/bun.d.cts",
        "default": "./dist/bun.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "TZ=UTC node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@libsql/client": ">=0.14",
    "better-sqlite3": ">=11",
    "mysql2": ">=3.9",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
