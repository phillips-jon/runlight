# frozen_string_literal: true

source "https://rubygems.org"

gemspec

gem "minitest", ">= 5.16"
gem "rake", ">= 13"

# Runlight::RackApp and the standalone server speak Rack; rack stays optional for apps.
gem "rack", ">= 2.2"

# The store and the Rails engine are tested against one Rails at a time: 8.1
# (the latest) by default, or the one RUNLIGHT_RAILS names ("8.0", "7.2").
# test/rails/gemfiles has a Gemfile per supported series with its own
# lockfile, so switching does not rewrite this one:
#
#   BUNDLE_GEMFILE=test/rails/gemfiles/rails_7_2.gemfile bundle install
#   BUNDLE_GEMFILE=test/rails/gemfiles/rails_7_2.gemfile bundle exec rake test
rails = ENV.fetch("RUNLIGHT_RAILS", "8.1")
group :test do
  gem "actionpack", "~> #{rails}.0"
  gem "activerecord", "~> #{rails}.0"
  gem "railties", "~> #{rails}.0"
  gem "pg", ">= 1.5"
  gem "mysql2", ">= 0.5.6"
  gem "trilogy", ">= 2.9"
  # Rails 8 takes sqlite3 2.x; 7.2 still takes 1.4 and up.
  gem "sqlite3", Gem::Version.new(rails) >= Gem::Version.new("8.0") ? ">= 2.1" : ">= 1.4"
  # The standalone server's tests start it on a port of their own.
  gem "webrick", ">= 1.8"
end
